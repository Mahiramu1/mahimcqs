rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function passwordOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    match /books/{uid}/{fileName} {
      allow read: if passwordOwner(uid);
      allow create, update: if passwordOwner(uid)
        && request.resource.size <= 20971520
        && request.resource.contentType == 'application/pdf';
      allow delete: if passwordOwner(uid);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

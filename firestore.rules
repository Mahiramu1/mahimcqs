rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Require a Firebase password-authenticated session, not legacy Google/OTP.
    function passwordSession() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function owns(uid) {
      return passwordSession() && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if owns(uid);
      match /books/{bookId} { allow read, write: if owns(uid); }
      match /saved/{savedId} {
        allow read, delete: if owns(uid);
        allow create, update: if false;
      }
      match /attempts/{attemptId} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }
    match /page_mcq_cache/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}

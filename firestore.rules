rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Require a Firebase password-authenticated session, not legacy Google/OTP.
    function passwordSession() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function owns(uid) {
      return passwordSession() && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if owns(uid);
      match /books/{bookId} {
        allow read, write: if owns(uid);
        match /reader_notes/{page} {
          allow read, delete: if owns(uid);
          allow create, update: if owns(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/books/$(bookId))
            && request.resource.data.keys().hasOnly(['text', 'bookmark'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 6000
            && request.resource.data.bookmark is bool;
        }
      }
      match /saved/{savedId} {
        allow read, delete: if owns(uid);
        allow create, update: if false;
      }
      match /study_material/{materialId} {
        allow read: if owns(uid);
        allow write: if false;
      }
      match /attempts/{attemptId} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }
    match /page_mcq_cache/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}

# Public Firebase WEB app configuration (safe for the browser; protect data with rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Secrets: set only on Node server / Hostinger deployment environment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_PROJECT_ID=
# Either use GOOGLE_APPLICATION_CREDENTIALS with a private local file, or set the 3 variables below:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PORT=3001

# Firebase Authentication: enable Email/Password in Firebase Console, disable Google and Phone after migrating users.
# Public Firebase WEB app configuration (safe for the browser; protect data with rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Secrets: set only on Node server / Hostinger deployment environment
# OpenAI powers the multi-page study workspace. Gemini powers the original single-page tools.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_PROJECT_ID=
# Either use GOOGLE_APPLICATION_CREDENTIALS with a private local file, or set the 3 variables below:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PORT=3001
